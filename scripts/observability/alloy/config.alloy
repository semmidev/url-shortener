logging {
  level  = "info"
  format = "logfmt"
}

// OpenTelemetry Receiver (gRPC on :4317, HTTP on :4318)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// Batch processor for OpenTelemetry data
otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.prometheus.input]
    logs    = [otelcol.exporter.loki.loki.input]
  }
}

// OTLP Exporter to Grafana Tempo for Traces
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = coalesce(sys.env("TEMPO_ENDPOINT"), "tempo:4317")
    tls {
      insecure = true
    }
  }
}

// Prometheus Exporter for Metrics
otelcol.exporter.prometheus "prometheus" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = coalesce(sys.env("PROMETHEUS_URL"), "http://prometheus:9090/api/v1/write")
  }
}

// Loki Exporter for OTLP Logs
otelcol.exporter.loki "loki" {
  forward_to = [loki.write.default.receiver]
}

// Docker / Podman Container Logs Discovery & Scraping
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.process.container_logs.receiver]
}

loki.process "container_logs" {
  stage.json {
    expressions = {
      level    = "level",
      msg      = "msg",
      time     = "time",
      trace_id = "trace_id",
      span_id  = "span_id",
      service  = "service",
    }
  }

  stage.labels {
    values = {
      level   = "level",
      service = "service",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// Loki Write Endpoint for all log streams
loki.write "default" {
  endpoint {
    url = coalesce(sys.env("LOKI_URL"), "http://loki:3100/loki/api/v1/push")
  }
}
