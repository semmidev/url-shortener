      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(cache_hits_total[1m])) or vector(0)",
          "legendFormat": "Cache Hits",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(cache_misses_total[1m])) or vector(0)",
          "legendFormat": "Cache Misses",
          "range": true,
          "refId": "B"
        }
      ],
