      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "db_pool_total_conns",
          "legendFormat": "Total Connections",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "db_pool_acquired_conns",
          "legendFormat": "Acquired (In-Use) Connections",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "db_pool_idle_conns",
          "legendFormat": "Idle Connections",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "db_pool_max_conns",
          "legendFormat": "Max Connections",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Worker PostgreSQL Connection Pool Status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
