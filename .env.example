# Application Settings
APP_ENV=development
APP_BASE_URL=http://localhost:8080
MIGRATION_URL=file://server/db/migration
# APP_LOCALE options: id (Indonesian), en (English)
APP_LOCALE=id

# Logging Settings
# LOG_LEVEL options: debug, info, warn, error
LOG_LEVEL=debug
# LOG_FORMAT options: text (human-readable key-value), json (structured JSON)
LOG_FORMAT=text
# LOG_ADD_SOURCE options: true (include file:line source), false
LOG_ADD_SOURCE=true
# LOG_REDIRECT_SAMPLE_RATE: sampling rate for redirect endpoint logs (0.0=none, 1.0=all).
# Set to 0.1 in production to log only ~10% of successful redirects and avoid log flooding.
LOG_REDIRECT_SAMPLE_RATE=1.0

# HTTP Server Settings
SERVER_ADDRESS=0.0.0.0:8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# Internal Management & Observability Server Settings (/metrics & /debug pprof)
MANAGEMENT_ENABLED=true
MANAGEMENT_ADDRESS=127.0.0.1:9090

# Rate Limiting Settings
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=1m
RATE_LIMIT_PUBLIC_REQUESTS=300
RATE_LIMIT_PUBLIC_WINDOW=1m

# Database Settings
DB_SOURCE=postgres://postgres:postgres@127.0.0.1:6432/urlshortener?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=15m
DB_MAX_CONN_LIFETIME=1h
# DB_PGBOUNCER_ENABLED: Set to true when connecting via PgBouncer (disables pgx statement cache for transaction pooling mode)
DB_PGBOUNCER_ENABLED=true
DB_DISABLE_STATEMENT_CACHE=false

# Worker Specific Settings
WORKER_DB_MAX_CONNS=10
WORKER_DB_MIN_CONNS=2
WORKER_CONCURRENCY=10

# PostgreSQL Container Settings (used by compose.yml)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=urlshortener

# JWT Security & Token Settings
JWT_SECRET=super-secret-32-byte-key-for-jwt-signing!
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=168h

# Google OAuth Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Database Backup Settings (used by db-backup service in compose.yml)
# BACKUP_SCHEDULE options: @daily, @hourly, or cron expression e.g. "0 2 * * *"
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=url-shortener-backups
BACKUP_S3_PREFIX=backups
# S3_ENDPOINT is optional - set for non-AWS S3-compatible storage (e.g. MinIO, Cloudflare R2)
S3_ENDPOINT=
